# =============================================================================
# MoodleKit Docker Environment Configuration Template
# Copy to .env or let ./moodlekit-docker.py init generate it automatically
# =============================================================================

# Central MariaDB Credentials
DB_ROOT_PASSWORD=change_this_root_password
DB_ADMIN_PASSWORD=change_this_admin_password
DB_BUFFER_POOL_SIZE=6144M

# Redis Shared Cache & Sessions
REDIS_PASSWORD=change_this_redis_password
REDIS_MAX_MEMORY=1536M

# Web & TLS Proxy Settings
LETSENCRYPT_EMAIL=admin@yourdomain.com
HTTP_PORT=80
HTTPS_PORT=443

# Base Application Image
MOODLE_IMAGE=moodlekit/moodle-app:8.3
