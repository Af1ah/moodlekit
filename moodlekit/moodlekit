#!/usr/bin/env bash
# =============================================================================
# MoodleKit — Main CLI Entry Point
# =============================================================================
# Moodle Fixer, Manager, Provisioner & Cloud Backup Toolkit
# Backed by AES-256 Encrypted Binary Vault Storage.
# Supports both Standalone Moodle Sites and Multi-Tenant Clusters.
# =============================================================================

export MOODLEKIT_VERSION="2.0.0"

# Determine script root dynamically
_SRC_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -d "${_SRC_DIR}/lib" ]]; then
    export MOODLEKIT_ROOT="${_SRC_DIR}"
else
    export MOODLEKIT_ROOT="/opt/moodlekit"
fi

export MOODLEKIT_LIB="${MOODLEKIT_ROOT}/lib"
export MOODLEKIT_CMD="${MOODLEKIT_ROOT}/commands"
export MOODLEKIT_TPL="${MOODLEKIT_ROOT}/templates"

export MOODLEKIT_STATE_DIR="/etc/moodlekit"
export MOODLEKIT_SITES_DIR="${MOODLEKIT_STATE_DIR}/sites"
export MOODLEKIT_OPT_DIR="/opt/moodlekit-data"
export MOODLEKIT_BACKUP_DIR="/var/backups/moodlekit"

# Options (parsed from global flags)
export MOODLEKIT_YES=0

# shellcheck source=lib/vault.sh
source "${MOODLEKIT_LIB}/vault.sh"
# shellcheck source=lib/common.sh
source "${MOODLEKIT_LIB}/common.sh"
# shellcheck source=lib/detect.sh
source "${MOODLEKIT_LIB}/detect.sh"
# shellcheck source=lib/interactive.sh
source "${MOODLEKIT_LIB}/interactive.sh"
# shellcheck source=lib/tuning.sh
source "${MOODLEKIT_LIB}/tuning.sh"
# shellcheck source=lib/db/postgres.sh
source "${MOODLEKIT_LIB}/db/postgres.sh"
# shellcheck source=lib/db/mariadb.sh
source "${MOODLEKIT_LIB}/db/mariadb.sh"
# shellcheck source=lib/db/mysql.sh
source "${MOODLEKIT_LIB}/db/mysql.sh"

# Load commands
for cmd_file in "${MOODLEKIT_CMD}"/*.sh; do
    # shellcheck source=/dev/null
    [[ -f "${cmd_file}" ]] && source "${cmd_file}"
done

# Initialize vault and auto-migrate legacy data
vault_init

# ---------------------------------------------------------------------------
# Global flag parser
# ---------------------------------------------------------------------------
parse_global_flags() {
    local new_args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -y|--yes)
                MOODLEKIT_YES=1
                shift
                ;;
            -v|--version)
                echo "MoodleKit v${MOODLEKIT_VERSION}"
                exit 0
                ;;
            -h|--help)
                print_help
                exit 0
                ;;
            *)
                new_args+=("$1")
                shift
                ;;
        esac
    done
    set -- "${new_args[@]}"
    eval "args=(\"\$@\")"
}

# ---------------------------------------------------------------------------
# Help string
# ---------------------------------------------------------------------------
print_help() {
    cat << EOF
MoodleKit v${MOODLEKIT_VERSION} — Moodle Fixer, Manager & Cloud Backup Toolkit

Usage: moodlekit [GLOBAL_FLAGS] <COMMAND> [ARGS...]

Global Flags:
  -y, --yes          Skip all confirmations (non-interactive mode)
  -v, --version      Show version
  -h, --help         Show this help

Diagnostic & Repair (Moodle Doctor):
  doctor, fix [target]   Diagnose and auto-fix permissions, dataroot, DB, PHP, FPM, Nginx, cron
  adopt [path] [slug]    Adopt an existing standalone Moodle directory into MoodleKit management

Host & Provisioning:
  bootstrap          Provision the host server (PHP, Nginx, DB, Redis, Certbot, UFW)
  tune [mode]        Re-tune server performance (balanced, conservative, aggressive)
  status             Show server health, stack status, and all detected Moodle sites

Site Management (Standalone & Multi-Tenant):
  site create <slug> Create a new Moodle site
  site adopt <path>  Adopt an existing Moodle site from disk
  site remove <slug> Delete a site and/or deregister from vault
  site list          List all managed and unmanaged Moodle sites
  site upgrade <slug> Upgrade a Moodle site to a newer version

Backup & Recovery:
  backup <slug>      Create a local backup (DB + moodledata + config + manifest)
  backup all         Create a local backup for all registered sites
  backup deploy      Deploy the Python cloud backup script + systemd timer (GDrive/Telegram)
  restore <slug> <backup_path>  Restore a site (in-place or fresh)
  restore manual     Interactive recovery from raw SQL and dataroot

Security & Vault:
  vault status       Show encrypted binary vault status and key location
  vault dump         Display decrypted vault JSON data (root only)
  vault migrate      Migrate legacy .conf files into encrypted vault
EOF
}

# ---------------------------------------------------------------------------
# Interactive Main Menu
# ---------------------------------------------------------------------------

_pick_site_slug() {
    local -n _slug_result="$1"
    local prompt="$2"
    local include_partial="${3:-0}"
    local -a slugs
    
    if [[ "${include_partial}" == "1" ]]; then
        mapfile -t slugs < <(list_removable_slugs 2>/dev/null)
    else
        mapfile -t slugs < <(list_site_slugs 2>/dev/null)
    fi

    if [[ ${#slugs[@]} -eq 0 ]]; then
        warn "No managed sites found in encrypted vault."
        _slug_result=""
        return 1
    fi

    select_one _slug_result "${prompt}" "${slugs[@]}"
    return 0
}

_interactive_main_menu() {
    section "MoodleKit — Main Menu"
    local choice=""
    select_one choice "Select an action:" \
        "Server: Bootstrap & Provision Host (Fresh Install PHP/Nginx/DB/Redis)" \
        "Server: Status & Health Overview" \
        "Server: Tune Performance (RAM-aware PHP/DB/Redis tuning)" \
        "Doctor: Diagnose & Fix Moodle site" \
        "Doctor: Fix entire server stack" \
        "Site: Create a new site (Moodle 5.2 or 4.5)" \
        "Site: Adopt existing standalone Moodle" \
        "Site: List all sites" \
        "Site: Upgrade a site" \
        "Site: Remove a site" \
        "Site: Restore a site" \
        "Backup: Single site" \
        "Backup: All or Selected sites" \
        "Backup: Deploy Cloud Sync" \
        "Backup: Select / Update Sites for Cloud Backup" \
        "Vault: Status & Security" \
        "Exit"

    case "${choice}" in
        *"Server: Bootstrap"*)
            cmd_bootstrap
            ;;

        *"Server: Status"*)
            cmd_status
            ;;

        *"Server: Tune"*)
            local tune_mode=""
            select_one tune_mode "Select tuning mode:" \
                "balanced" "conservative" "aggressive"
            cmd_tune "${tune_mode}"
            ;;

        *"Doctor: Diagnose & Fix Moodle site"*)
            cmd_fix
            ;;

        *"Doctor: Fix entire server stack"*)
            _doctor_server_stack
            ;;

        *"Site: Create"*)
            cmd_site_create
            ;;

        *"Site: Adopt"*)
            cmd_adopt
            ;;

        *"Site: List"*)
            cmd_site_list
            ;;

        *"Site: Remove"*)
            local rem_slug=""
            if ! _pick_site_slug rem_slug "Select site to remove:" "1"; then return; fi
            cmd_site_remove "${rem_slug}"
            ;;

        *"Site: Upgrade"*)
            local upg_slug=""
            if ! _pick_site_slug upg_slug "Select site to upgrade:"; then return; fi
            cmd_site_upgrade "${upg_slug}"
            ;;

        *"Site: Restore"*)
            local method_choice=""
            select_one method_choice "Select restore method:" \
                "Fresh restore from backup directory" \
                "Manual / Legacy recovery (raw SQL + files)"

            if [[ "${method_choice}" == *"Manual"* ]]; then
                cmd_restore "manual" ""
            else
                local rst_slug=""
                input_text rst_slug "Slug for the restored site (e.g. mysite)" "" '^[a-z0-9]+$' "Lowercase alphanumeric only"
                local backup_path=""
                input_path backup_path "Absolute path to backup directory" ""
                [[ -d "${backup_path}" ]] || { err "Backup directory not found: ${backup_path}"; return 1; }
                cmd_restore "${rst_slug}" "${backup_path}"
            fi
            ;;

        *"Backup: Single"*)
            local bk_slug=""
            if ! _pick_site_slug bk_slug "Select site to back up:"; then return; fi
            cmd_backup_site "${bk_slug}"
            ;;

        *"Backup: All"*)
            cmd_backup_all
            ;;

        *"Backup: Deploy"*)
            cmd_backup_deploy
            ;;

        *"Backup: Select"*)
            cmd_backup_select_sites
            ;;

        *"Vault: Status"*)
            python3 "${MOODLEKIT_LIB}/vault.py" status
            ;;

        *"Exit"*)
            exit 0
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Main Router
# ---------------------------------------------------------------------------
main() {
    parse_global_flags "$@"
    set -- "${args[@]}"

    local cmd="${1:-}"
    local subcmd="${2:-}"
    shift 2 2>/dev/null || shift 1 2>/dev/null || true

    case "${cmd}" in
        doctor|fix)
            cmd_fix "${subcmd}" "$@"
            ;;
        adopt)
            cmd_adopt "${subcmd}" "$@"
            ;;
        bootstrap)
            cmd_bootstrap "$@"
            ;;
        tune)
            cmd_tune "${subcmd}" "$@"
            ;;
        status)
            cmd_status "$@"
            ;;
        site)
            case "${subcmd}" in
                create)  cmd_site_create "$@" ;;
                adopt)   cmd_adopt "$@" ;;
                remove)  cmd_site_remove "$@" ;;
                list)    cmd_site_list "$@" ;;
                upgrade) cmd_site_upgrade "$@" ;;
                *)       err "Unknown site command: ${subcmd}"; print_help; exit 1 ;;
            esac
            ;;
        backup)
            case "${subcmd}" in
                all)          cmd_backup_all "$@" ;;
                deploy)       cmd_backup_deploy "$@" ;;
                select|sites) cmd_backup_select_sites "$@" ;;
                "")           err "Usage: moodlekit backup <slug|all|deploy|select>"; exit 1 ;;
                *)            cmd_backup_site "${subcmd}" "$@" ;;
            esac
            ;;
        restore)
            cmd_restore "${subcmd}" "$@"
            ;;
        vault)
            case "${subcmd}" in
                status)  python3 "${MOODLEKIT_LIB}/vault.py" status ;;
                dump)    python3 "${MOODLEKIT_LIB}/vault.py" dump ;;
                migrate) python3 "${MOODLEKIT_LIB}/vault.py" migrate ;;
                *)       err "Usage: moodlekit vault <status|dump|migrate>"; exit 1 ;;
            esac
            ;;
        *)
            if [[ -n "${cmd}" ]]; then
                err "Unknown command: ${cmd}"
                echo ""
                print_help
                exit 1
            fi
            
            # Interactive mode
            _interactive_main_menu
            ;;
    esac
}

main "$@"
