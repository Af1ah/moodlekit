[Unit]
Description=Run MoodleKit cloud backup daily at 2AM

[Timer]
# Fire at 02:00 every day
OnCalendar=*-*-* 02:00:00
# Add up to 5 minutes random jitter to avoid hammering upstream at exactly 02:00
RandomizedDelaySec=300
# If the system was off when the timer was due, run it on next boot
Persistent=true

[Install]
WantedBy=timers.target
