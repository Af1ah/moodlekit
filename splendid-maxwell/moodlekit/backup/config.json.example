{
  "server_name": "MoodleServer-01",
  "log_dir": "/var/log/moodlekit",
  "local_backup_root": "/var/backups/moodlekit",
  "gdrive_remote": "gdrive:moodlekit-backups",
  "rclone": {
    "transfers": 4,
    "checkers": 8,
    "tpslimit": 10,
    "drive_chunk_size": "128M",
    "bwlimit": "0",
    "extra_flags": []
  }
}
